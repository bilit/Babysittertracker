# ─── Home Assistant connection ────────────────────────────────────────────────
# Your HA instance URL (no trailing slash)
HA_URL=http://homeassistant.local:8123

# Long-lived access token (Profile → Security → Long-Lived Access Tokens)
HA_TOKEN=your_long_lived_access_token_here

# ─── Camera / sensor entity IDs ───────────────────────────────────────────────
# Entity ID of your Nest doorbell camera
CAMERA_ENTITY=camera.front_door

# Entity ID of the person detection binary sensor on that camera
PERSON_SENSOR=binary_sensor.front_door_person

# ─── Snapshot storage ─────────────────────────────────────────────────────────
# Directory where HA saves person-detection snapshots.
# If using docker-compose this maps to /config/www/snapshots inside the container.
# Set to an empty string to use only HA event history (no local files).
SNAPSHOT_DIR=/config/www/snapshots

# ─── App settings ─────────────────────────────────────────────────────────────
# SQLite database file location
DB_PATH=/data/babysitter.db

# Your local timezone (used for correct rate calculation)
TIMEZONE=America/New_York

# Port the app listens on
PORT=5050

# Set to 1 to enable Flask debug mode (do NOT use in production)
FLASK_DEBUG=0
