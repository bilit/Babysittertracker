# ── Home Assistant connection ──────────────────────────────────────────────
# URL of your HA instance (no trailing slash)
HA_URL=http://192.168.1.100:8123

# Long-lived access token from HA Profile → Long-Lived Access Tokens
HA_TOKEN=your_long_lived_token_here

# ── Nest entity IDs ────────────────────────────────────────────────────────
# Camera entity (find in Developer Tools → States)
CAMERA_ENTITY=camera.front_door

# Person/motion entity
PERSON_SENSOR=event.front_door_bell_motion

# ── Clips directory ────────────────────────────────────────────────────────
# Path on the HOST where HA stores Nest event media.
# This gets mounted read-only into the container as /config.
# Typical paths:
#   HA OS:     /mnt/data/supervisor/homeassistant/.cache/nest/event_media
#   HA Docker: /your/ha/config/.cache/nest/event_media
SNAPSHOT_DIR=/config/.cache/nest/event_media

# ── Other ──────────────────────────────────────────────────────────────────
TIMEZONE=America/New_York
PORT=5050
